<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- PANE 1: profile cards (main modal, centered) -->
    <ScrollView
        android:id="@+id/pane_cards"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        android:background="@drawable/panel_bg"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profiles"
                android:textColor="#E8E8EC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="One profile per agent. Tap a card to edit, connect straight from the card."
                android:textColor="#8A8A93"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No profiles yet. Add one below."
                android:textColor="#6A6A72"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="+ New profile" />

            <!-- this phone's public name — what every hub sees on pairing -->
            <TextView
                android:id="@+id/row_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingVertical="4dp"
                android:text="Phone name: —"
                android:textColor="#8A8A93"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- PANE 2: editor (hidden until a card / new is tapped). Land: docks
         right so the live head preview beside it stays visible. -->
    <ScrollView
        android:id="@+id/pane_editor"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="24dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/panel_bg"
        android:fillViewport="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#8249; Back"
                    android:textColor="#7FA0FF"
                    android:textSize="15sp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/editor_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New profile"
                    android:textColor="#E8E8EC"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/f_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Name (e.g. server · Hermes)"
                android:textColor="#E8E8EC"
                android:textColorHint="#6A6A72"
                android:background="@drawable/edit_bg"
                android:padding="10dp"
                android:inputType="text"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/f_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Server URL (ws://host:8765/gadget)"
                android:textColor="#E8E8EC"
                android:textColorHint="#6A6A72"
                android:background="@drawable/edit_bg"
                android:padding="10dp"
                android:inputType="textUri"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/f_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Access token (leave empty if none)"
                android:textColor="#E8E8EC"
                android:textColorHint="#6A6A72"
                android:background="@drawable/edit_bg"
                android:padding="10dp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Head look"
                android:textColor="#E8E8EC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Make each agent instantly recognizable. Tap to preview live."
                android:textColor="#8A8A93"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/shape_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/color_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save" />

                <Button
                    android:id="@+id/btn_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8A8A93"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
