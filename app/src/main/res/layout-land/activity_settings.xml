<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="24dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/panel_bg"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profiles"
                android:textColor="#E8E8EC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="One profile per agent or host. Tapping one reconnects the gadget there."
                android:textColor="#8A8A93"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <RadioGroup
                android:id="@+id/profile_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No profiles yet. Add one below."
                android:textColor="#6A6A72"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Editing"
                android:textColor="#E8E8EC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/f_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Name (e.g. server · Hermes)"
                android:textColor="#E8E8EC"
                android:textColorHint="#6A6A72"
                android:background="@drawable/edit_bg"
                android:padding="10dp"
                android:inputType="text"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/f_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Server URL (ws://host:8765/gadget)"
                android:textColor="#E8E8EC"
                android:textColorHint="#6A6A72"
                android:background="@drawable/edit_bg"
                android:padding="10dp"
                android:inputType="textUri"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/f_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Access token (leave empty if none)"
                android:textColor="#E8E8EC"
                android:textColorHint="#6A6A72"
                android:background="@drawable/edit_bg"
                android:padding="10dp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Head look"
                android:textColor="#E8E8EC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Make each agent instantly recognizable. Tap to preview live."
                android:textColor="#8A8A93"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/shape_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/color_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save + connect" />

                <Button
                    android:id="@+id/btn_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New" />

                <Button
                    android:id="@+id/btn_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_done"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Close" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8A8A93"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
